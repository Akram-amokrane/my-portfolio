---
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="work" class="relative scroll-mt-24 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.work.eyebrow} title={t.work.title} lead={t.work.lead} index="03" />

    <div data-timeline class="relative mt-14 pl-8 sm:pl-12">
      <!-- Spine -->
      <div class="absolute bottom-2 left-[7px] top-2 w-px bg-line sm:left-[11px]" aria-hidden="true">
        <div
          data-timeline-fill
          class="h-full w-full origin-top scale-y-0 bg-linear-to-b from-ember via-ember-soft to-cyan"
        ></div>
      </div>

      <ol class="space-y-8 sm:space-y-10">
        {t.work.jobs.map((job, i) => (
          <li data-reveal="left" style={`--reveal-delay:${i * 90}ms`} class="relative">
            <!-- Node -->
            <span
              class="absolute -left-8 top-6 grid size-[15px] place-items-center rounded-full border-2 border-bg bg-line-strong sm:-left-12 sm:size-[23px]"
              aria-hidden="true"
            >
              <span class:list={['block size-[7px] rounded-full sm:size-[9px]', job.current ? 'bg-ember' : 'bg-faint']}></span>
              {job.current && (
                <span class="absolute inset-0 rounded-full bg-ember/40 motion-safe:animate-[pulse-ring_2.2s_ease-out_infinite]"></span>
              )}
            </span>

            <article data-tilt="3" class="card spotlight noise relative overflow-hidden p-5 sm:p-7">
              <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
                <div>
                  <h3 class="font-display text-lg font-semibold tracking-tight sm:text-xl">{job.role}</h3>
                  <p class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm">
                    <span class="font-medium text-ember">{job.org}</span>
                    <span class="text-faint">·</span>
                    <span class="text-muted">{job.place}</span>
                  </p>
                </div>

                <span class:list={[
                  'shrink-0 rounded-full border px-3 py-1 font-mono text-[11px] font-medium',
                  job.current ? 'border-ember/40 bg-ember/10 text-ember' : 'border-line text-muted',
                ]}>
                  {job.period}
                </span>
              </div>

              <p class="mt-4 text-pretty text-sm leading-relaxed text-muted">{job.summary}</p>

              <ul class="mt-3.5 space-y-1.5">
                {job.points.map((point) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mt-1.5 size-3 shrink-0 text-ember" aria-hidden="true">
                      <path d="M5 12h14m0 0-5-5m5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>

              <ul class="mt-5 flex flex-wrap gap-1.5">
                {job.tags.map((tag) => (
                  <li class="rounded-md border border-line bg-surface-2/60 px-2.5 py-1 font-mono text-[11px] text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
