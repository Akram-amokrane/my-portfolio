---
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="about" class="relative scroll-mt-24 py-24 sm:py-32">
  <div class="pointer-events-none absolute -left-24 top-1/3 -z-10 size-96 rounded-full bg-[var(--glow-b)] blur-[120px]" data-parallax="-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.about.eyebrow} title={t.about.title} index="01" />

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <!-- Narrative -->
      <div>
        <p data-reveal class="text-balance font-display text-xl font-medium leading-snug sm:text-2xl">
          {t.about.lead}
        </p>

        <div class="mt-7 space-y-5">
          {t.about.body.map((para, i) => (
            <p data-reveal style={`--reveal-delay:${i * 90}ms`} class="text-pretty leading-relaxed text-muted">
              {para}
            </p>
          ))}
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-3 self-start sm:gap-4">
        {t.about.stats.map((stat, i) => (
          <div
            data-reveal="scale"
            style={`--reveal-delay:${i * 80}ms`}
            data-tilt="6"
            class="card spotlight noise relative overflow-hidden p-5 sm:p-6"
          >
            <div
              class="font-display text-3xl font-bold tracking-tight text-ember sm:text-4xl"
              data-count={stat.value}
            >{stat.value}</div>
            <div class="mt-1.5 text-xs font-medium leading-snug text-muted sm:text-sm">{stat.label}</div>
            <div class="pointer-events-none absolute -right-5 -top-5 size-16 rounded-full bg-ember/10 blur-xl"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
