---
import SectionHeading from './SectionHeading.astro';
import { profile, useTranslations, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const details = [
  {
    label: t.contact.emailLabel,
    value: profile.email,
    href: `mailto:${profile.email}`,
    icon: 'M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9Zm.8-.7 7.5 5.6a1.2 1.2 0 0 0 1.4 0l7.5-5.6',
    copy: profile.email,
  },
  {
    label: t.contact.phoneLabel,
    value: profile.phone,
    href: `tel:${profile.phoneHref}`,
    icon: 'M6.6 3h2.6l1.6 4-2 1.2a12 12 0 0 0 5 5l1.2-2 4 1.6v2.6a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3Z',
    copy: profile.phone,
  },
  {
    label: t.contact.locationLabel,
    value: `${profile.city}, ${profile.region}`,
    icon: 'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  },
];
---

<section id="contact" class="relative scroll-mt-24 overflow-hidden py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10 grid-bg opacity-70 [mask-image:radial-gradient(ellipse_at_50%_50%,#000,transparent_72%)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 size-[38rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,var(--glow-a),transparent_66%)] blur-[100px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.contact.eyebrow} title={t.contact.title} lead={t.contact.lead} align="center" index="07" />

    <div data-reveal style="--reveal-delay:180ms" class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href={`mailto:${profile.email}`}
        data-magnetic="0.25"
        class="group inline-flex items-center gap-2.5 rounded-xl bg-ember px-7 py-4 text-base font-semibold text-white shadow-[0_12px_40px_-14px] shadow-ember/70 transition-colors duration-300 hover:bg-ember-soft"
      >
        {t.contact.cta}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
          <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <button
        type="button"
        data-copy={profile.email}
        class="group relative inline-flex items-center gap-2.5 rounded-xl border border-line-strong px-7 py-4 text-base font-semibold transition-colors duration-300 hover:border-ember hover:text-ember"
      >
        <span class="[.is-copied_&]:invisible">{t.contact.copy}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4 [.is-copied_&]:invisible" aria-hidden="true">
          <rect x="9" y="9" width="12" height="12" rx="2" />
          <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
        </svg>
        <span class="absolute inset-0 hidden items-center justify-center gap-2 text-ember [.is-copied_&]:flex">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="size-4" aria-hidden="true">
            <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {t.contact.copied}
        </span>
      </button>
    </div>

    <!-- Details -->
    <dl class="mt-14 grid gap-3 sm:grid-cols-2">
      {details.map((item, i) => {
        const Tag = item.href ? 'a' : 'div';
        return (
          <Tag
            {...(item.href ? { href: item.href } : {})}
            data-reveal="scale"
            style={`--reveal-delay:${i * 70}ms`}
            data-tilt="4"
            class:list={[
              'card spotlight noise group relative flex items-center gap-4 overflow-hidden p-5',
              // Odd count would otherwise orphan the last card in a 2-up grid.
              details.length % 2 === 1 && i === details.length - 1 && 'sm:col-span-2',
            ]}
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-lg border border-line bg-ember/10 text-ember transition-colors duration-300 group-hover:bg-ember group-hover:text-white">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4.5" aria-hidden="true">
                <path d={item.icon} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div class="min-w-0">
              <dt class="font-mono text-[11px] uppercase tracking-wider text-faint">{item.label}</dt>
              <dd class="mt-0.5 truncate text-sm font-medium">{item.value}</dd>
            </div>
            {item.href && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-auto size-4 shrink-0 text-faint transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-ember" aria-hidden="true">
                <path d="M7 17 17 7m0 0H8m9 0v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </Tag>
        );
      })}
    </dl>
  </div>
</section>
