---
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="research" class="relative scroll-mt-24 overflow-hidden py-24 sm:py-32">
  <div class="pointer-events-none absolute -right-32 top-1/4 -z-10 size-[28rem] rounded-full bg-[var(--glow-b)] blur-[130px]" data-parallax="-12" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.research.eyebrow} title={t.research.title} lead={t.research.lead} index="05" />

    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      {t.research.items.map((item, i) => (
        <article
          data-reveal="scale"
          style={`--reveal-delay:${i * 100}ms`}
          data-tilt="5"
          class="card spotlight noise group relative flex flex-col overflow-hidden p-6 sm:p-8"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="inline-flex items-center gap-2 rounded-full border border-violet/40 bg-violet/10 px-3 py-1 font-mono text-[11px] font-medium text-violet">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5" aria-hidden="true">
                {i === 0 ? (
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6ZM14 2v6h6M8 13h8M8 17h5" stroke-linecap="round" stroke-linejoin="round" />
                ) : (
                  <path d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3ZM19 11a7 7 0 0 1-14 0M12 18v3M8 21h8" stroke-linecap="round" stroke-linejoin="round" />
                )}
              </svg>
              {item.kind}
            </span>
            <span class="font-mono text-xs text-faint">{item.date}</span>
          </div>

          <h3 class="mt-5 text-balance font-display text-lg font-semibold leading-snug tracking-tight sm:text-xl">
            {item.title}
          </h3>

          <p class="mt-3 grow text-pretty text-sm leading-relaxed text-muted">{item.summary}</p>

          {item.href && (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex w-fit items-center gap-2 rounded-lg border border-line-strong px-4 py-2.5 text-sm font-semibold transition-colors duration-300 hover:border-ember hover:text-ember"
            >
              {item.cta}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true">
                <path d="M7 17 17 7m0 0H8m9 0v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )}

          <div class="pointer-events-none absolute -right-10 -top-10 size-32 rounded-full bg-violet/8 blur-2xl"></div>
        </article>
      ))}
    </div>
  </div>
</section>
