---
import SectionHeading from './SectionHeading.astro';
import { techTags, useTranslations, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const ICONS: Record<string, string> = {
  layout: 'M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-13ZM3 9h18M9 21V9',
  server: 'M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v3A1.5 1.5 0 0 1 18.5 10h-13A1.5 1.5 0 0 1 4 8.5v-3ZM4 15.5A1.5 1.5 0 0 1 5.5 14h13a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-3ZM7.5 7h.01M7.5 17h.01',
  database: 'M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3ZM4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6',
  terminal: 'M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM7.5 9.5 10 12l-2.5 2.5M13 15h4',
  brain: 'M9.5 3A3 3 0 0 0 7 7.5 3.5 3.5 0 0 0 4.5 11a3.5 3.5 0 0 0 1.2 2.6A3 3 0 0 0 5 16a3 3 0 0 0 4.5 2.6V3ZM14.5 3A3 3 0 0 1 17 7.5a3.5 3.5 0 0 1 2.5 3.5 3.5 3.5 0 0 1-1.2 2.6A3 3 0 0 1 19 16a3 3 0 0 1-4.5 2.6V3ZM12 3v18',
};

const ACCENT: Record<string, string> = {
  ember: 'var(--ember)',
  cyan: 'var(--cyan)',
  violet: 'var(--violet)',
};
---

<style is:global>
  /* Only absolutely position the tags once the sphere script owns them. */
  [data-tag-sphere].is-3d [data-tag] {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
  }
</style>

<section id="skills" class="relative scroll-mt-24 overflow-hidden border-y border-line bg-bg-alt/50 py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-0 -z-10 grid-bg opacity-60 [mask-image:radial-gradient(ellipse_at_50%_0%,#000,transparent_70%)]" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.skills.eyebrow} title={t.skills.title} lead={t.skills.lead} index="02" />

    <div class="mt-14 grid items-start gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
      <!-- 3D tag sphere -->
      <div data-reveal="scale" class="relative order-2 lg:order-1 lg:sticky lg:top-28">
        <div class="pointer-events-none absolute inset-0 -z-10 rounded-full bg-[radial-gradient(circle_at_50%_50%,var(--glow-a),transparent_62%)] blur-2xl" aria-hidden="true"></div>

        {/* Without JS this stays a tidy centred tag cloud; the script flips it
            to `.is-3d` and takes over positioning. */}
        <div
          data-tag-sphere
          class="relative mx-auto flex aspect-square w-full max-w-[30rem] flex-wrap content-center items-center justify-center gap-2 touch-none select-none [&.is-3d]:cursor-grab [&.is-3d.is-grabbing]:cursor-grabbing"
        >
          {techTags.map((tag) => (
            <span
              data-tag
              class="whitespace-nowrap rounded-full border border-line bg-surface/70 px-2.5 py-1 font-mono text-[11px] font-medium backdrop-blur-sm transition-colors duration-200 will-change-transform hover:border-ember hover:text-ember sm:text-xs"
            >{tag}</span>
          ))}
        </div>

        <p class="mt-4 text-center font-mono text-[11px] uppercase tracking-[0.2em] text-faint">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mr-1.5 inline size-3.5 align-[-2px]" aria-hidden="true">
            <path d="M12 3v18M3 12h18" stroke-linecap="round" />
          </svg>
          {t.skills.hint}
        </p>
      </div>

      <!-- Skill groups -->
      <div class="order-1 space-y-3.5 lg:order-2">
        {t.skills.groups.map((group, gi) => (
          <div
            data-reveal="left"
            style={`--reveal-delay:${gi * 70}ms`}
            data-tilt="4"
            class="card spotlight noise relative overflow-hidden p-5 sm:p-6"
          >
            <div class="flex items-center gap-3">
              <span
                class="grid size-9 shrink-0 place-items-center rounded-lg border border-line"
                style={`background:color-mix(in oklab, ${ACCENT[group.accent]} 12%, transparent); color:${ACCENT[group.accent]}`}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4.5" aria-hidden="true">
                  <path d={ICONS[group.icon]} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <h3 class="font-display text-base font-semibold tracking-tight sm:text-lg">{group.title}</h3>
            </div>

            <ul class="mt-4 space-y-2.5">
              {group.skills.map((skill) => (
                <li>
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="text-sm font-medium">{skill.name}</span>
                    <span class="font-mono text-[11px] text-faint">{skill.level}%</span>
                  </div>
                  <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-surface-2">
                    <div
                      data-bar={skill.level}
                      class="h-full origin-left rounded-full"
                      style={`transform:scaleX(0); background:linear-gradient(90deg, ${ACCENT[group.accent]}, color-mix(in oklab, ${ACCENT[group.accent]} 45%, var(--cyan)))`}
                    ></div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
