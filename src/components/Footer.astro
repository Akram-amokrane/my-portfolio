---
import { profile, useTranslations, localePath, otherLocale, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);
const year = new Date().getFullYear();
---

<footer class="relative border-t border-line bg-bg-alt/60 py-12">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-between">
      <div class="flex items-center gap-3">
        <span class="grid size-9 place-items-center rounded-lg border border-line bg-surface/60 text-[13px] font-bold text-ember">
          {profile.initials}
        </span>
        <div>
          <p class="font-display text-sm font-semibold tracking-tight">{profile.name}</p>
          <p class="text-xs text-faint">© {year} — {t.footer.rights}</p>
        </div>
      </div>

      <p class="order-last text-center text-xs text-faint sm:order-none">{t.footer.built}</p>

      <div class="flex items-center gap-2">
        <a
          href={`mailto:${profile.email}`}
          aria-label={t.contact.emailLabel}
          class="grid size-9 place-items-center rounded-lg border border-line text-muted transition-colors duration-300 hover:border-ember hover:text-ember"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-4" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2.5" />
            <path d="m3.8 6.8 7.5 5.6a1.2 1.2 0 0 0 1.4 0l7.5-5.6" stroke-linecap="round" />
          </svg>
        </a>
        <a
          href={profile.legacyPortfolio}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.contact.portfolioLabel}
          class="grid size-9 place-items-center rounded-lg border border-line text-muted transition-colors duration-300 hover:border-ember hover:text-ember"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="size-4" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z" />
          </svg>
        </a>
        <a
          href={localePath(other, '/')}
          class="grid h-9 place-items-center rounded-lg border border-line px-3 font-mono text-[11px] font-semibold uppercase tracking-wider text-muted transition-colors duration-300 hover:border-ember hover:text-ember"
        >
          {other}
        </a>
      </div>
    </div>
  </div>
</footer>
