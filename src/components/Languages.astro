---
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="languages" class="relative scroll-mt-24 border-t border-line py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:items-center lg:gap-16">
      <SectionHeading eyebrow={t.languages.eyebrow} title={t.languages.title} index="06" />

      <ul class="space-y-5">
        {t.languages.items.map((lang, i) => (
          <li data-reveal="right" style={`--reveal-delay:${i * 80}ms`}>
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-display text-base font-semibold tracking-tight sm:text-lg">{lang.name}</span>
              <span class="font-mono text-[11px] uppercase tracking-wider text-faint">{lang.level}</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-surface-2">
              <div
                data-bar={lang.value}
                class="h-full origin-left rounded-full bg-linear-to-r from-ember to-cyan"
                style="transform:scaleX(0)"
              ></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
