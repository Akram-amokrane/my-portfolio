---
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Locale } from '../i18n/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="education" class="relative scroll-mt-24 border-y border-line bg-bg-alt/50 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHeading eyebrow={t.education.eyebrow} title={t.education.title} index="04" />

    <div class="mt-12 grid gap-3.5 sm:grid-cols-2">
      {t.education.degrees.map((degree, i) => (
        <div
          data-reveal="scale"
          style={`--reveal-delay:${i * 75}ms`}
          data-tilt="5"
          class="card spotlight noise group relative overflow-hidden p-5 sm:p-6"
        >
          <div class="flex items-start justify-between gap-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-line bg-cyan/10 text-cyan">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4.5" aria-hidden="true">
                <path d="M22 9 12 4 2 9l10 5 10-5Z" stroke-linejoin="round" />
                <path d="M6 11.5V17c0 1.1 2.7 2.5 6 2.5s6-1.4 6-2.5v-5.5M20 10v5" stroke-linecap="round" />
              </svg>
            </span>

            {degree.note && (
              <span class="shrink-0 rounded-full border border-ember/40 bg-ember/10 px-2.5 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider text-ember">
                {degree.note}
              </span>
            )}
          </div>

          <h3 class="mt-4 text-balance font-display text-base font-semibold leading-snug tracking-tight sm:text-lg">
            {degree.title}
          </h3>
          <p class="mt-1.5 text-sm text-muted">{degree.org}</p>
          <p class="mt-3 font-mono text-xs text-faint">{degree.period}</p>

          <div class="pointer-events-none absolute -bottom-8 -right-8 size-24 rounded-full bg-cyan/5 blur-2xl transition-opacity duration-500 group-hover:bg-ember/10"></div>
        </div>
      ))}
    </div>
  </div>
</section>
